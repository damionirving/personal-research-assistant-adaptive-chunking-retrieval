FROM public.ecr.aws/lambda/python:3.12

COPY requirements-lambda.txt requirements-ragas-worker.txt ${LAMBDA_TASK_ROOT}/

RUN pip install --no-cache-dir --disable-pip-version-check \
    -r ${LAMBDA_TASK_ROOT}/requirements-ragas-worker.txt \
    -t ${LAMBDA_TASK_ROOT}

# Fail the image build if the runtime cannot import the evaluation libraries.
RUN python -c "import datasets, ragas; print('RAGAS worker dependencies imported successfully')"

COPY apps ${LAMBDA_TASK_ROOT}/apps
COPY platform ${LAMBDA_TASK_ROOT}/platform
COPY docs ${LAMBDA_TASK_ROOT}/docs

ENV PYTHONPATH=${LAMBDA_TASK_ROOT}/apps/api/src:${LAMBDA_TASK_ROOT}/platform/core/src

CMD ["pra_api.ragas_worker.handler"]
