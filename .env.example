PRA_SERVICE_NAME=personal-research-assistant
PRA_SERVICE_VERSION=0.1.0
PRA_ENVIRONMENT=local
PRA_DEBUG=false
PRA_RETRIEVAL_DIAGNOSTICS_ENABLED=true
PRA_LOG_LEVEL=INFO
PRA_LOG_FORMAT=json
PRA_API_ROOT_PATH=
PRA_ALLOWED_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
PRA_AUTH_PROVIDER=cognito
PRA_AWS_REGION=us-east-1
PRA_COGNITO_USER_POOL_ID=
PRA_COGNITO_CLIENT_ID=
PRA_COGNITO_ISSUER=
PRA_COGNITO_HOSTED_UI_BASE_URL=
PRA_DOCUMENT_BUCKET_NAME=
PRA_PERSISTENCE_BACKEND=file
PRA_PERSISTENCE_DATA_DIR=.pra_data
PRA_PERSISTENCE_S3_PREFIX=pra-prod
PRA_VECTOR_STORE_BACKEND=persistent
PRA_OPENSEARCH_ENDPOINT=
PRA_OPENSEARCH_INDEX_NAME=pra-chunks
PRA_PGVECTOR_DSN=
PRA_PGVECTOR_TABLE_NAME=pra_chunks
PRA_RAG_EVAL_DATASET_PATH=data/rag_eval_dataset_v2.json
PRA_CLOUDWATCH_LOG_GROUP=
PRA_CLOUDWATCH_LOG_STREAM=
LANGSMITH_PROJECT=personal-research-assistant
# Local-only LangSmith overrides. AWS deployment reads these fields from Secrets Manager.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
PRA_LLM_PROVIDER=mock
PRA_BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-1-20250805-v1:0
PRA_BEDROCK_SIMPLE_MODEL_ID=google.gemma-3-12b-it
PRA_BEDROCK_REASONING_MODEL_ID=mistral.mistral-large-3-675b-instruct
PRA_BEDROCK_REASONING_FALLBACK_MODEL_ID=arn:aws:bedrock:us-east-1::inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0
PRA_BEDROCK_MAX_TOKENS=700
PRA_BEDROCK_TEMPERATURE=0.2
PRA_EMBEDDING_PROVIDER=local
PRA_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
PRA_BEDROCK_EMBEDDING_DIMENSIONS=1024
PRA_BM25_TOP_K=50
PRA_VECTOR_TOP_K=50
PRA_RRF_K=30
PRA_FUSION_STRATEGY=weighted_rrf
PRA_BM25_FUSION_WEIGHT=0.8
PRA_VECTOR_FUSION_WEIGHT=0.2
PRA_PRESERVE_BM25_CANDIDATES=true
PRA_ENABLE_BM25_LEXICAL=true
PRA_ENABLE_VECTOR_SEARCH=true
PRA_ENABLE_RECIPROCAL_RANK_FUSION=true
PRA_ENABLE_RERANKING=false
PRA_RERANK_TOP_K=50
PRA_LLM_CONTEXT_TOP_K=10
PRA_CHUNK_SIZE=600
PRA_CHUNK_OVERLAP=100
PRA_DOCUMENT_UPLOAD_ENABLED=true
PRA_KNOWLEDGE_GRAPH_ENABLED=true
PRA_GRAPH_RETRIEVAL_ENABLED=true
PRA_GRAPH_EXTRACTION_LLM_ENABLED=true
# Opt-in adaptive RAG. Leaving these disabled preserves MVP ingestion and retrieval.
PRA_ADAPTIVE_CHUNKING_ENABLED=false
PRA_ADAPTIVE_RETRIEVAL_ENABLED=false
PRA_TABLE_PROCESSING_ENABLED=true
PRA_DOMAIN_DETECTION_ENABLED=true
PRA_DOCUMENT_TYPE_DETECTION_ENABLED=true
PRA_RELATIONSHIP_EXTRACTION_ENABLED=true
PRA_HIERARCHICAL_CHUNKING_ENABLED=true
PRA_RELATIONSHIP_RETRIEVAL_ENABLED=true
PRA_PARENT_CHILD_EXPANSION_ENABLED=true
PRA_QUERY_EXPANSION_ENABLED=true
PRA_ADAPTIVE_CHUNKING_PROFILE=auto
PRA_ADAPTIVE_RETRIEVAL_PROFILE=auto
PRA_CHUNK_MIN_TOKENS=80
PRA_CHUNK_TARGET_TOKENS=300
PRA_CHUNK_MAX_TOKENS=600
PRA_CHUNK_OVERLAP_TOKENS=60
PRA_RETRIEVAL_VECTOR_TOP_K=30
PRA_RETRIEVAL_BM25_TOP_K=30
PRA_RETRIEVAL_FUSED_TOP_K=30
PRA_RETRIEVAL_FINAL_TOP_K=10
PRA_RETRIEVAL_VECTOR_WEIGHT=0.45
PRA_RETRIEVAL_BM25_WEIGHT=0.40
PRA_RETRIEVAL_RELATIONSHIP_WEIGHT=0.15
PRA_RERANKER_MODE=deterministic
PRA_RERANKER_MODEL_ID=
PRA_CHUNK_ANALYSIS_MODEL_ID=
PRA_QUERY_PLANNER_MODEL_ID=
PRA_EMBEDDING_DIMENSIONS=64
PRA_GUARDRAIL_BLOCKED_TERMS=production-agentcore
PRA_RATE_LIMIT_CHAT_REQUESTS=30
PRA_RATE_LIMIT_CHAT_WINDOW_SECONDS=60
PRA_RATE_LIMIT_UPLOAD_REQUESTS=5
PRA_RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
PRA_RATE_LIMIT_PUBLIC_REQUESTS=60
PRA_RAG_EVALUATION_ENABLED=true
PRA_RAG_EVAL_DATASET_PATH=data/rag_eval_dataset_v2.json
PRA_RAGAS_ENABLED=true
PRA_RAGAS_USE_NORMAL_MODEL_ROUTING=false
PRA_RAGAS_EVALUATION_QUEUE_URL=
PRA_RAGAS_EVAL_DATASET_PATH=data/rag_eval_dataset_v2.json
PRA_RAGAS_EVALUATOR_MODEL_ID=
PRA_RAGAS_EMBEDDING_MODEL_ID=
PRA_RAGAS_MAX_QUESTIONS=50
PRA_RAGAS_BATCH_SIZE=1
PRA_RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
